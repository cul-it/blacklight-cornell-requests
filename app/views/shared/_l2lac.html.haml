-## Testing for @iis presence because callslip needs it
-## but not sure if callslip is even sticking around (what's
-## the difference between it and L2L?)
- Rails.logger.debug "mjc12test: itemstouse - #{@items}"
-if (@items.present? && @items.length > 0)
  .row.mb-3
    .col-form-label.col-sm-2
      -if (@items.length > 1)
        Select a copy:
      -elsif (@items.length == 1)
        This copy:
    .col-sm-10
      -@items.each do |i|
        .form-check
          -if (@items.length == 1)
            %input.form-check-input.copy-select(id="copy-#{i.id}" type="radio" name="holding_id" value="#{i.id}" data-exclude-location="#{i.excluded_locations}" checked)
          -else
            %input.form-check-input.copy-select(id="copy-#{i.id}" type="radio" name="holding_id" value="#{i.id}" data-exclude-location="#{i.excluded_locations}")
          %label.form-check-label{ :for => "copy-#{i.id}"}
            = "#{i.location['name']} #{i.enumeration} "
            - if i.copy_number
              = "c. #{i.copy_number} "
            %span.copy-callnumber
              = " - #{i.call_number}"
