-## Testing for @iis presence because callslip needs it
-## but not sure if callslip is even sticking around (what's
-## the difference between it and L2L?)
- Rails.logger.debug "mjc12test: itemstouse - #{@items}"
-if (@iis.present? && @iis.length > 0)
  .row.mb-3
    .col-form-label.col-sm-2
      -if (@iis.length > 1)
        Select a copy:
      -elsif (@iis.length == 1)
        This copy:
    .col-sm-10
      -if @iis.length > 1
        .form-check
          %input.form-check-input.copy-select(id="copy-any" type="radio" name="holding_id" value="any" data-exclude-location="[]")
          %label.form-check-label{ :for => "copy-any"} Any Copy
      -@iis.each do |copyn, copyd|
        .form-check
          -if (@iis.length == 1)
            %input.form-check-input.copy-select(id="copy-#{copyn}" type="radio" name="holding_id" value="#{copyn}" data-exclude-location="#{copyd[:exclude_location_id]}" checked)
          -else
            %input.form-check-input.copy-select(id="copy-#{copyn}" type="radio" name="holding_id" value="#{copyn}" data-exclude-location="#{copyd[:exclude_location_id]}")
          %label.form-check-label{ :for => "copy-#{copyn}"}
            = "#{copyd[:location]} #{copyd[:item_enum]} "
            - if copyd[:copy_number]
              = "c. #{copyd[:copy_number]} "
            %span.copy-callnumber
              = copyd[:call_number]
            -if copyd[:chron].present?
              %span.copy-chron.label
                = copyd[:chron]
-else
  -if (@items.present? && @items.length > 0)
    .row.mb-3
      .col-form-label.col-sm-2
        -if (@items.length > 1)
          Select a copy:
        -elsif (@items.length == 1)
          This copy:
      .col-sm-10
        -@items.each do |i|
          .form-check
            -if (@items.length == 1)
              %input.form-check-input.copy-select(id="copy-#{i.id}" type="radio" name="holding_id" value="#{i.id}" data-exclude-location="#{i.excluded_locations}" checked)
            -else
              %input.form-check-input.copy-select(id="copy-#{i.id}" type="radio" name="holding_id" value="#{i.id}" data-exclude-location="#{i.excluded_locations}")
            %label.form-check-label{ :for => "copy-#{i.id}"}
              = "#{i.location['name']} #{i.enumeration} "
              - if i.copy_number
                = "c. #{i.copy_number} "
              %span.copy-callnumber
                = " - #{i.call_number}"
