-d30 = 30.day.from_now
-d60 = 60.day.from_now
-d180 = 180.day.from_now
.row.mb-3
  .col-form-label.col-sm-2 If item remains unavailable, cancel request after:
  .col-sm-10
    %fieldset#latest-date
      %legend.visually-hidden Cancel after
      .form-check
        %input.form-check-input(type="radio" name="latest-date" value="#{d30.strftime("%Y-%m-%d")}" id="days_30")
        %label.form-check-label{ :for => "days_30"}
          30 days (#{d30.strftime("%m-%d-%Y")})
      .form-check
        %input.form-check-input(type="radio" name="latest-date" value="#{d60.strftime("%Y-%m-%d")}" id="days_60")
        %label.form-check-label{ :for => "days_60"}
          60 days (#{d60.strftime("%m-%d-%Y")})
      .form-check
        %input.form-check-input(type="radio" name="latest-date" value="#{d180.strftime("%Y-%m-%d")}" id="days_180" checked="checked")
        %label.form-check-label{ :for => "days_180"}
          180 days (#{d180.strftime("%m-%d-%Y")})